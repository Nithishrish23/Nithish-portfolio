# Google Apps Script Web App endpoint used by /api/contact
# Set this same value in Vercel Environment Variables as GOOGLE_SHEET_WEBHOOK_URL.
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbyCfnbqSww4O3Ab_Yn2qmBv8wU4R3cgSlL9Aib7wG2Xjejscsq2Kv6KcN2Xg5RzBb_9qQ/exec

# Optional: enables the portfolio assistant to use the OpenAI Responses API.
# If omitted, /api/chat uses the built-in profile knowledge fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
