# Google Apps Script Web App endpoint used by /api/contact
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbyCfnbqSww4O3Ab_Yn2qmBv8wU4R3cgSlL9Aib7wG2Xjejscsq2Kv6KcN2Xg5RzBb_9qQ/exec

# OpenAI-compatible Ollama server. For local Ollama use http://localhost:11434/v1.
# For Vercel, this must be a reachable HTTPS endpoint on your VPS/server.
OLLAMA_BASE_URL=https://YOUR-OLLAMA-SERVER/v1
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_API_KEY=ollama
